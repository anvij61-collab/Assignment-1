import java.util.Scanner;
public class BankLoanEligiblityandEMISchedules {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter monthly Salary:");
        double salary = sc.nextDouble();
        System.out.print("Enter existing EMIs:");
        double existingEMIs = sc.nextDouble();
        System.out.print("Enter credit score:");
        int creditScore = sc.nextInt();
        System.out.print("Enter loan amount:");
        double loanAmount = sc.nextDouble();
        System.out.print("Enter annual interest rate:");
        double annualInterestRate = sc.nextDouble();
        System.out.print("Enter months to repay:");
        int months = sc.nextInt();

        if(salary >= 25000 && creditScore >= 700 && existingEMIs <= 0.5 * salary) {
            System.out.println("You are eligible for the loan.");
            double maxPerMissibleEMI = 0.5 * salary - existingEMIs;

            double Interest = (loanAmount * annualInterestRate * months) / 1200;
            double totalAmount = loanAmount + Interest;
            double monthlyEMI = totalAmount / months;

            System.out.println("Maximum permissible EMI: " + maxPerMissibleEMI);
            System.out.println("Monthly EMI for the loan: " + monthlyEMI);
        } else {
            System.out.println("You are not eligible for the loan.");
        }
    }
}
